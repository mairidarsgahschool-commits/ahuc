<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · AHUC' : 'AHUC Clinic System' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="app-header">
  <div class="app-header-inner">
    <a href="/" class="brand">
      <svg viewBox="0 0 26 26" width="24" height="24" fill="none"><circle cx="13" cy="13" r="12" stroke="#1F6F72" stroke-width="1.6"/><path d="M4 13c2-5 3.5 8 5.5 4S12 9 13 13s2 6 4-1 3 1 5-3" stroke="#B5622F" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>
      AHUC
    </a>
    <nav class="app-nav">
      <a href="/">Dashboard</a>
      <a href="/patients">Patients</a>
      <a href="/doctors">Referring doctors</a>
      <% if (currentUser.role === 'admin') { %><a href="/users">Staff accounts</a><% } %>
    </nav>
    <div class="app-user">
      <span><%= currentUser.full_name %> <em>(<%= currentUser.role %>)</em></span>
      <form action="/logout" method="post"><button type="submit" class="link-btn">Log out</button></form>
    </div>
    <button type="button" class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobileNav">
    <a href="/">Dashboard</a>
    <a href="/patients">Patients</a>
    <a href="/patients/new">+ New patient</a>
    <a href="/doctors">Referring doctors</a>
    <% if (currentUser.role === 'admin') { %><a href="/users">Staff accounts</a><% } %>
    <div class="mobile-nav-user">
      <span><%= currentUser.full_name %> <em>(<%= currentUser.role %>)</em></span>
      <form action="/logout" method="post"><button type="submit" class="link-btn">Log out</button></form>
    </div>
  </nav>
</header>
<script>
  (function(){
    var btn = document.getElementById('navToggle');
    var panel = document.getElementById('mobileNav');
    if (!btn || !panel) return;
    btn.addEventListener('click', function(){
      var open = panel.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    panel.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ panel.classList.remove('open'); btn.classList.remove('open'); });
    });
  })();
</script>
<main class="app-main">
<% } %>
