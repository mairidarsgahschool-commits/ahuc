<%- include('partials/header', { title: (editing ? 'Edit report' : 'Obs Case') + ' — ' + patient.name }) %>

<div class="page-head">
  <div>
    <span class="eyebrow">Patient #<%= patient.id %> · <%= patient.name %></span>
    <h1><%= editing ? 'Edit obstetric ultrasound report' : 'Obstetric ultrasound report' %></h1>
    <p>Pre-filled with the normal-report template. Edit only what's abnormal for this patient.</p>
  </div>
</div>

<div class="card card-pad">
  <form method="post" action="<%= editing ? `/reports/obs/${reportId}/edit` : `/patients/${patient.id}/report/obs` %>">
    <div class="field">
      <label for="gestation">Gestation</label>
      <textarea id="gestation" name="gestation" rows="2"><%= data.gestation || '' %></textarea>
    </div>
    <div class="field">
      <label for="amniotic_fluid">Amniotic fluid</label>
      <textarea id="amniotic_fluid" name="amniotic_fluid" rows="2"><%= data.amniotic_fluid || '' %></textarea>
    </div>
    <div class="field">
      <label for="placenta">Placenta</label>
      <textarea id="placenta" name="placenta" rows="2"><%= data.placenta || '' %></textarea>
    </div>
    <div class="field">
      <label for="cvs">Fetal cardiovascular system</label>
      <textarea id="cvs" name="cvs" rows="2"><%= data.cvs || '' %></textarea>
    </div>
    <div class="field">
      <label for="lie">Lie / presentation</label>
      <textarea id="lie" name="lie" rows="2"><%= data.lie || '' %></textarea>
    </div>
    <div class="field">
      <label for="fetal_morphology">Fetal morphology</label>
      <textarea id="fetal_morphology" name="fetal_morphology" rows="3"><%= data.fetal_morphology || '' %></textarea>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="biometry">Biometry</label>
        <textarea id="biometry" name="biometry" rows="2"><%= data.biometry || '' %></textarea>
      </div>
      <div class="field">
        <label for="edd">Estimated date of delivery</label>
        <input type="date" id="edd" name="edd" value="<%= data.edd || '' %>">
      </div>
    </div>
    <div class="field">
      <label for="remarks">Remarks / impression</label>
      <textarea id="remarks" name="remarks" rows="2"><%= data.remarks || '' %></textarea>
    </div>

    <div class="section-label">Sign-off</div>
    <div class="form-grid">
      <div class="field">
        <label for="sonographer">Sonographer</label>
        <input type="text" id="sonographer" name="sonographer" value="<%= data.sonographer || currentUser.full_name %>">
      </div>
      <div class="field">
        <label for="radiologist">Reporting radiologist</label>
        <input type="text" id="radiologist" name="radiologist" placeholder="Dr. …" value="<%= data.radiologist || '' %>">
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= editing ? 'Save changes' : 'Save & generate report' %></button>
      <a href="<%= editing ? `/reports/obs/${reportId}/print` : `/patients/${patient.id}` %>" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
