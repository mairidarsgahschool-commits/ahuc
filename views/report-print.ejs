<%- include('partials/header', { title: type + ' — ' + patient.name }) %>

<div class="report-toolbar no-print">
  <a href="/patients/<%= patient.id %>" class="btn btn-outline btn-sm">← Back to patient</a>
  <div style="display:flex; gap:10px;">
    <a href="<%= editUrl %>" class="btn btn-outline btn-sm">Edit report</a>
    <button onclick="window.print()" class="btn btn-dark btn-sm">Print / Save as PDF</button>
  </div>
</div>

<div class="report-page-wrap">
  <%- include('partials/report-body', { report, patient, type }) %>
</div>

<%- include('partials/footer') %>
