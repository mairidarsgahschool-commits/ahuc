<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title><%= type %> — <%= patient.name %> · AHUC</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:var(--paper); overflow-x:auto;">

<div class="share-page">
  <div class="share-page-head no-print">
    <div class="brand" style="color:var(--ink);">
      <svg viewBox="0 0 26 26" width="24" height="24" fill="none"><circle cx="13" cy="13" r="12" stroke="#1F6F72" stroke-width="1.6"/><path d="M4 13c2-5 3.5 8 5.5 4S12 9 13 13s2 6 4-1 3 1 5-3" stroke="#B5622F" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>
      AHUC
    </div>
    <button onclick="window.print()" class="btn btn-dark btn-sm">Print / Save as PDF</button>
  </div>

  <%- include('partials/report-body', { report, patient, type, qrDataUrl: undefined }) %>

  <p class="share-page-footer no-print">
    This is a secure, view-only copy of your ultrasound report from Ali Hospital &amp; Ultra Sound Centre.
    This link is unique to this report — please don't forward it to anyone you don't want to see these results.
  </p>
</div>

</body>
</html>
